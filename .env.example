# SentinelTrace environment (copy to .env)

# PostgreSQL
POSTGRES_USER=sentineltrace
POSTGRES_PASSWORD=changeme_local_only
POSTGRES_DB=sentineltrace
DATABASE_URL=postgresql+psycopg://sentineltrace:changeme_local_only@db:5432/sentineltrace

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Ingestion limits
MAX_UPLOAD_BYTES=104857600
INGEST_BATCH_SIZE=500

# Detection
RULES_PATH=/app/rules
DETECTION_DEFAULT_SINCE_HOURS=168

# Display defaults (API may expose to frontend)
DEFAULT_TIMEZONE=UTC
DEFAULT_PAGE_SIZE=50

# App
SENTINELTRACE_ENV=local
LOG_LEVEL=INFO
